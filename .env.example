DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=http://localhost:3000

# Hosted LLM (any OpenAI-compatible chat completions API)
HOSTED_BASE_URL=https://api.openai.com/v1
HOSTED_API_KEY=
HOSTED_MODEL=gpt-4o-mini

# Local open-weight model via Ollama (docker compose --profile local up)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

RATE_LIMIT_PER_MINUTE=60
